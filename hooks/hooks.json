{
  "description": "logbook: add the working rules to every session, preview the briefing when a plan is submitted, and stop a turn from ending while the branch's open PR has no debriefing.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\"/hooks/session-rules.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\"/hooks/plan-preview.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\"/hooks/plan-preview.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\"/hooks/debrief-gate.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
